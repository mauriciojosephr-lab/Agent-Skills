    "projects_remain_separate",
    "no_secret_values_in_evidence",
    "no_completion_without_evidence",
    "high_risk_actions_require_explicit_approval",
    "autonomous_writes_use_pull_requests",
    "external_connector_absence_is_fail_closed"
  ]
