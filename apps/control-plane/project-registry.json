{
  "version": 1,
  "controlPlane": "chatgpt",
  "orchestratorRepository": "salamou1944/agent-skills",
  "projects": {
    "agent-skills": {
      "repository": "salamou1944/agent-skills",
      "role": "orchestrator",
      "allowed": ["read", "propose", "test", "verify"],
      "writePolicy": "pull-request-only"
    },
    "Salamou-31": {
      "repository": "salamou1944/Salamou-31",
      "role": "ai-product-content-api",
      "allowed": ["read", "propose", "test", "verify"],
      "writePolicy": "pull-request-only"
    },
    "Easy-": {
      "repository": "salamou1944/Easy-",
      "role": "ecommerce-product",
      "allowed": ["read", "propose", "test", "verify"],
      "writePolicy": "pull-request-only"
    },
    "AI_operating_memory": {
      "repository": "salamou1944/AI_operating_memory",
      "role": "canonical-memory",
      "allowed": ["read", "propose", "test", "verify"],
      "writePolicy": "pull-request-only"
    }
  },
  "externalSystems": {
    "github": {"connector": "github", "required": true},
    "railway": {"connector": "railway", "required": false},
    "vercel": {"connector": "vercel", "required": false},
    "supabase": {"connector": "supabase", "required": false}
