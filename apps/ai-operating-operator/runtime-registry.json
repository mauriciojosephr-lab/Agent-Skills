{
  "version": 1,
  "runtimes": {
    "operator-runtime": {
      "type": "node-process",
      "executionMode": "background",
      "workspaceEnv": "OPERATOR_WORKSPACE",
      "credentials": {
        "github": "GITHUB_TOKEN",
        "railway": "RAILWAY_TOKEN",
        "vercel": "VERCEL_TOKEN",
        "supabase": "SUPABASE_ACCESS_TOKEN",
        "browser": "OPERATOR_BROWSER_SESSION"
      },
      "policy": {
        "noAuthBypass": true,
        "noCredentialExport": true,
        "failClosed": true,
        "boundedTimeoutMs": 120000,
        "maxRetries": 2
      }
    }
  }
}
